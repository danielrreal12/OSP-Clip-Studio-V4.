# Copy to the host environment (Render dashboard, or a local shell).
# Never commit a real key.

# Required for autonomous editing. Without it the UI shows a configuration
# error and will not pretend an AI edit ran.
OPENAI_API_KEY=

# openai is the supported provider. AI_BASE_URL is optional and lets you point
# the official SDK at an OpenAI-compatible endpoint.
AI_PROVIDER=openai
AI_BASE_URL=
VISION_MODEL=gpt-4o-mini
DIRECTOR_MODEL=gpt-4o-mini
TRANSCRIBE_MODEL=whisper-1
AI_TIMEOUT_SEC=120

# Durable storage. On Render, attach a disk and point this at the mount.
WORK_DIR=/var/data/osp
MAX_UPLOAD_MB=250
MAX_MUSIC_MB=30
MAX_DURATION_SEC=600
MIN_DURATION_SEC=0.4

# Keep this at 1 on a 512MB–2GB instance. FFmpeg is the memory bottleneck.
MAX_CONCURRENT_JOBS=1
MAX_QUEUED_JOBS=3
JOB_TTL_HOURS=48
MIN_FREE_MB=768

ENCODE_PRESET=veryfast
ENCODE_CRF=23
OUTPUT_FPS=30
PORTRAIT_WIDTH=720
PORTRAIT_HEIGHT=1280
LANDSCAPE_WIDTH=1280
LANDSCAPE_HEIGHT=720
FFMPEG_TIMEOUT_SEC=900

# Budgets are hard stops. The job fails with a clear message instead of
# continuing past the cap.
BUDGET_MAX_FRAMES=16
BUDGET_MAX_CLOSEUPS=2
BUDGET_MAX_TOKENS=80000
BUDGET_MAX_TRANSCRIBE_SEC=600
BUDGET_MAX_RENDER_SEC=900
BUDGET_MAX_STORAGE_MB=2048
BUDGET_MAX_COST_USD=1.50
BUDGET_MAX_RETRIES=2
HIGHLIGHT_MAX_SEC=45

RATE_LIMIT_UPLOADS=12
RATE_LIMIT_WINDOW_SEC=3600
TRUST_PROXY=0
LOG_JSON=0

# Optional price overrides. Default rates are labeled estimates in the UI.
# Example: {"gpt-4o-mini":{"input_per_million":0.15,"output_per_million":0.60},"whisper-1":{"per_minute":0.006}}
AI_PRICE_JSON=
